{
  "name": "react-pokemon-quiz",
  "author": "monktana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm run gen:theme",
    "dev": "vite",
    "build": "tsc && vite build",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:unit": "vitest",
    "test:unit:ci": "vitest --run",
    "gen:api": "npx swagger-typescript-api --no-client --route-types -p http://localhost:5190/swagger/v1/swagger.json -o ./src/api/schema -n models.tsxx",
    "gen:theme": "chakra typegen ./src/theme/index.ts",
    "lint": "npx eslint --fix src/",
    "prettier": "prettier --ignore-path .gitignore --write \"**/*.+(js|json|ts|tsx)\"",
    "prettier:write": "npm run prettier -- --write"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.102.1",
    "@tanstack/react-query-devtools": "^5.102.1",
    "framer-motion": "^13.1.1",
    "ky": "^2.0.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swagger-typescript-api": "^13.12.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.36.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/eslint-plugin-query": "^5.102.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
